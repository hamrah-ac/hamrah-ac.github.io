---
import home from '../../content/pages/home.json';
const { changes } = home;
---

<section dir="RTL" class="changes" id="what-changes">
  <div class="changes-stage">
    <div class="title-row">
      <div class="changes-title">
        <p class="t-eyebrow">{changes.eyebrow}</p>
        <h2 class="t-h2 balance">{changes.title}</h2>
      </div>
    </div>
    <div class="changes-grid">
      {changes.cards.map((card) => (
        <article dir="RTL" class="changes-card">
          <h3 class="t-h4">{card.title}</h3>
          <div class="scene">
            <img class="scene-bg" src={card.image} alt={card.imageAlt} width="1000" height="681" loading="lazy" />
          </div>
          <p class="t-body-m changes-desc">{card.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .changes { width: 100%; background: var(--black); }
  .changes-stage { width: 100%; padding: 100px 0; display: flex; flex-direction: column; align-items: center; gap: 80px; }
  .title-row { width: 100%; max-width: var(--canvas); padding: 0 20px; display: flex; flex-direction: column; align-items: center; }
  .changes-title { width: 700px; max-width: 100%; display: flex; flex-direction: column; gap: 24px; text-align: center; }

  .changes-grid {
    width: 100%;
    max-width: var(--canvas);
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .changes-card { display: flex; flex-direction: column; gap: 20px; padding: 40px; border-radius: 16px; background: var(--surface); overflow: clip; }
  .changes-desc { color: var(--dark-grey); align-self: stretch; }
  .scene { position: relative; width: 100%; height: 300px; flex: none; border-radius: 16px; overflow: clip; }
  .scene-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 809.98px) {
    .changes-stage { padding: 60px 0; gap: 40px; }
    .changes-grid { grid-template-columns: 1fr; }
    .changes-card { padding: 20px; }
  }
</style>